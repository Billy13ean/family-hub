{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "dontAsk",
    "allow": [
      "Bash(./hm *)",
      "mcp__plugin_imessage_imessage",
      "Read(~/Library/Messages/Attachments/**)"
    ],
    "deny": [
      "Bash(./hm summary --send*)",
      "Bash(./hm digest-loop*)",
      "Read(~/.config/**)",
      "Read(~/.claude/**)",
      "Read(~/Library/Messages/chat.db*)",
      "Edit",
      "Write",
      "NotebookEdit",
      "WebFetch",
      "WebSearch"
    ]
  }
}
